msgstr "Uygulamanın yürütülebilir dosya adı, örneğin notepad.exe"

msgid "Enter an executable name ending in .exe."
msgstr ".exe ile biten bir uygulama dosyası adı girin."

msgid "Delete this application profile and its assignments?"
msgstr "Bu uygulama profili ve atamaları silinsin mi?"

msgid "NVDA action"
msgstr "NVDA eylemi"

msgid "Keyboard shortcut"
msgstr "Klavye kısayolu"

msgid "Windows shortcut"
msgstr "Windows kısayolu"

msgid "Launch an application"
msgstr "Uygulama başlat"

msgid "Choose an action type"
msgstr "Eylem türü seçin"

msgid "Choose an NVDA action"
msgstr "NVDA eylemi seçin"

msgid "Choose an application"
msgstr "Uygulama seçin"

msgid "Windows applications"
msgstr "Windows uygulamaları"

msgid "Enter a shortcut, for example control+f or windows+e."
msgstr "Bir kısayol girin. Örneğin control+f veya windows+e."

msgid "Invalid shortcut."
msgstr "Geçersiz kısayol."

msgid "Delete this custom gesture from all profiles?"
msgstr "Bu özel hareket tüm profillerden silinsin mi?"

msgid "The touchpad could not be opened for recording."
msgstr "Touchpad kayıt için açılamadı."

msgid "Perform the confirmation sample now."
msgstr "Doğrulama hareketini şimdi yapın."

msgid "Perform the first sample now."
msgstr "İlk hareketi şimdi yapın."

msgid "First sample recorded. Start the confirmation sample."
msgstr "İlk örnek kaydedildi. Doğrulama örneğini başlatın."

msgid "Samples match. The gesture can be saved."
msgstr "Örnekler eşleşti. Hareketi kaydedebilirsiniz."

msgid "The two samples did not match. Record both again."
msgstr "İki örnek eşleşmedi. İkisini de yeniden kaydedin."

msgid "Enter a gesture name."
msgstr "Bir hareket adı girin."

msgid "This gesture matches a saved gesture. Assign the saved gesture to the profile."
msgstr "Bu hareket kayıtlı bir hareketle eşleşiyor. Kayıtlı hareketi profile atayın."

msgid "Gesture added. Press OK to save changes."
msgstr "Hareket eklendi. Değişiklikleri kaydetmek için Tamam’a basın."

msgid "Settings could not be saved."
msgstr "Ayarlar kaydedilemedi."

msgid "The settings and layouts file could not be imported."
msgstr "Ayar ve düzen dosyası içe aktarılamadı."

msgid "Settings and layouts imported. Press OK to save changes."
msgstr "Ayarlar ve düzenler içe aktarıldı. Kaydetmek için Tamam’a basın."

msgid "The settings and layouts file could not be exported."
msgstr "Ayar ve düzen dosyası dışa aktarılamadı."

msgid "Settings and layouts exported."
msgstr "Ayarlar ve düzenler dışa aktarıldı."

msgid "Swipe right"
msgstr "Sağa kaydırma"

msgid "Swipe left"
msgstr "Sola kaydırma"

msgid "Swipe up"
msgstr "Yukarı kaydırma"

msgid "Swipe down"
msgstr "Aşağı kaydırma"

msgid "Turn rotor clockwise"
msgstr "Rotoru saat yönünde döndürme"

msgid "Turn rotor counterclockwise"
msgstr "Rotoru saat yönünün tersine döndürme"

msgid "Single-finger double tap"
msgstr "Tek parmakla çift dokunma"

msgid "Three-finger swipe right"
msgstr "Üç parmakla sağa kaydırma"

msgid "Three-finger swipe left"
msgstr "Üç parmakla sola kaydırma"

msgid "Switch to the next open window"
msgstr "Sonraki açık pencereye geç"

msgid "Switch to the previous open window"
msgstr "Önceki açık pencereye geç"

msgid "Interface and guide language"
msgstr "Arayüz ve kılavuz dili"

msgid "Open user guide…"
msgstr "Kullanım kılavuzunu aç…"

msgid "The user guide could not be opened."
msgstr "Kullanım kılavuzu açılamadı."

msgid "This NVDA action is unavailable in the current application."
msgstr "Bu NVDA eylemi etkin uygulamada kullanılamıyor."

msgid "The assigned action could not be run."
msgstr "Atanan eylem çalıştırılamadı."

msgid "Start gesture wizard…"
msgstr "Hareket sihirbazını başlat…"

msgid "Record the first sample"
msgstr "İlk örneği kaydet"

msgid "Confirm the gesture"
msgstr "Hareketi doğrula"

msgid "Name the gesture and assign an action"
msgstr "Hareketi adlandır ve eylem ata"

msgid "Test the gesture"
msgstr "Hareketi dene"

msgid "Draw one continuous gesture with one finger, then lift it."
msgstr "Tek parmağınızla kesintisiz bir hareket çizin ve parmağınızı kaldırın."

msgid "Waiting for a touchpad gesture."
msgstr "Dokunmatik yüzey hareketi bekleniyor."

msgid "Record again"
msgstr "Yeniden kaydet"

msgid "Test again"
msgstr "Tekrar dene"

msgid "Test the assigned action in the target application after saving settings"
msgstr "Ayarları kaydettikten sonra atanan eylemi hedef uygulamada dene"

msgid "Choose action…"
msgstr "Eylem seç…"

msgid "No action selected."
msgstr "Eylem seçilmedi."

msgid "Record the first sample before continuing."
msgstr "Devam etmeden önce ilk örneği kaydedin."

msgid "Record a matching confirmation sample before continuing."
msgstr "Devam etmeden önce eşleşen bir doğrulama örneği kaydedin."

msgid "Use this gesture in the selected profile?"
msgstr "Bu hareket seçilen profilde kullanılsın mı?"

msgid "Enter a gesture name and choose an action before continuing."
msgstr "Devam etmeden önce hareket adı girin ve bir eylem seçin."

msgid "This gesture overlaps a built-in gesture: {gestures}."
msgstr "Bu hareket yerleşik bir hareketle çakışıyor. Çakışan hareket {gestures}."

msgid "Draw the gesture again to test recognition. The action runs in the application after saving."
msgstr "Algılamayı denemek için hareketi tekrar çizin. Eylem, kaydettikten sonra uygulamada çalışır."

msgid "First sample recorded. Select Next to confirm."
msgstr "İlk örnek kaydedildi. Doğrulamak için İleri’yi seçin."

msgid "Samples did not match. Record the confirmation again or go back."
msgstr "Örnekler eşleşmedi. Doğrulama örneğini yeniden kaydedin veya geri dönün."

msgid "This gesture matches the saved gesture {name}. Go back to record a different gesture."
msgstr "Bu hareket, kayıtlı {name} hareketiyle eşleşiyor. Farklı bir hareket kaydetmek için geri dönün."

msgid "Samples match. Select Next to assign an action."
msgstr "Örnekler eşleşti. Bir eylem atamak için İleri’yi seçin."

msgid "Test passed. The gesture was recognized."
msgstr "Deneme başarılı. Hareket tanındı."

msgid "Gesture not recognized. Select Test again to retry."
msgstr "Hareket tanınmadı. Yeniden denemek için Tekrar dene’yi seçin."

msgid "Switch to the target application and draw the gesture within 30 seconds."
msgstr "Hedef uygulamaya geçip 30 saniye içinde hareketi çizin."

msgid "The action test timed out."
msgstr "Eylemi deneme süresi doldu."

msgid "Test gesture recognized. The assigned action was sent."
msgstr "Deneme hareketi tanındı. Atanan eylem gönderildi."

msgid "Tap or swipe with one to five fingers, or draw with one finger. Lift all fingers when finished."
msgstr "Bir ila beş parmakla dokunun veya kaydırın ya da tek parmakla bir şekil çizin. Bitirince tüm parmaklarınızı kaldırın."

msgid "Windows could not suspend every built-in touchpad gesture on this device."
msgstr "Windows, bu cihazdaki yerleşik touchpad hareketlerinin tümünü duraklatamadı."

msgid "No gesture was recognized. Lift all fingers and try again."
msgstr "Hareket tanınmadı. Tüm parmaklarınızı kaldırıp tekrar deneyin."

msgid "One-finger drawing."
msgstr "Tek parmakla çizim."

msgid "Single tap"
msgstr "Tek dokunma"

msgid "Double tap"
msgstr "Çift dokunma"

msgid "Triple tap"
msgstr "Üç kez dokunma"

msgid "Fingers: {count}. {gesture}."
msgstr "{count} parmak. {gesture}."

